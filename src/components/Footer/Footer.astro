---
import FrameCardMacOS from "@/components/StyledCards/FrameCard-macOS.astro";
import FooterInfo from "./Footer-Info.astro";
---

<div class="footer-divider"></div>

<footer class="footer-wrap">
  <FrameCardMacOS>
    <div class="footer-inner">
      <div class="footer-left">
        <FooterInfo />
      </div>
      <div class="footer-right">
        <p class="footer-contact">
          欢迎通过邮箱联系我 👉
          <a href="mailto:cilxry@outlook.com" class="footer-link">cilxry@outlook.com</a>
        </p>
        <p class="footer-stacks">
          Stacks: <a href="https://astro.build/" class="footer-link">Astro</a>
          &amp; <a href="https://unocss.nodejs.cn/" class="footer-link">UnoCSS</a>
        </p>
      </div>
    </div>
  </FrameCardMacOS>
</footer>

<style>
  .footer-divider {
    max-width: 72rem;
    margin: 2.5rem auto 1.5rem;
    padding: 0 1rem;
  }
  .footer-divider::after {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cp-800), transparent);
    opacity: 0.5;
  }
  .footer-wrap {
    max-width: 72rem;
    margin: 0 auto 2.5rem;
    padding: 0 1rem;
    font-family: var(--font-list-standard);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-right {
      text-align: right;
    }
  }
  .footer-contact,
  .footer-stacks {
    margin: 0.35rem 0;
    line-height: 1.6;
  }
  .footer-link {
    color: var(--cp-300);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer-link:hover {
    color: var(--cp);
    text-decoration: underline;
  }
</style>
