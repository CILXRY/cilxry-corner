---
// 内联目录组件 - 接收服务端 headings 渲染 TOC 目录
import List from "@lucide/astro/icons/list";
import ArrowUp from "@lucide/astro/icons/arrow-up-from-line";
import ArrowDown from "@lucide/astro/icons/arrow-down-to-line";

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
  maxDepth?: number;
}

const { headings, maxDepth = 3 } = Astro.props;

// 找出 h1 作为"回到开头"的目标
const firstH1 = headings.find((h) => h.depth === 1);

// 过滤出需要显示的标题（h2 及以上，不超过 maxDepth）
const filteredHeadings = headings.filter(
  (h) => h.depth >= 2 && h.depth <= maxDepth,
);
---

{
  (filteredHeadings.length > 0 || firstH1) && (
    <div class="toc-inline">
      <div class="toc-header">
        <List class="toc-icon" size="16" />
        <span class="toc-title">目录</span>
      </div>
      <nav class="toc-nav" id="toc-nav">
        <ul class="toc-list">
          <!-- 回到开头（h1 或文章顶部） -->
          {firstH1 && (
            <li class="toc-item toc-depth-1">
              <a href={`#${firstH1.slug}`} class="toc-link toc-link-top">
                {firstH1.text}
              </a>
            </li>
          )}
          {
            filteredHeadings.map((h) => (
              <li class:list={["toc-item", `toc-depth-${h.depth}`]}>
                <a href={`#${h.slug}`} class="toc-link">
                  {h.text}
                </a>
              </li>
            ))
          }
          <!-- 跳到底部 -->
          <li class="toc-item toc-depth-1">
            <a href="#comment" class="toc-link toc-link-bottom">
              评论&nbsp;&nbsp;↓
            </a>
          </li>
        </ul>
      </nav>
    </div>
  )
}

<script>
  (function () {
    const nav = document.getElementById("toc-nav");
    if (!nav) return;

    const links = nav.querySelectorAll(".toc-link");

    // 收集标题 slug 列表（排除顶部/底部导航）
    const headings = [];
    links.forEach(function (link) {
      if (link.classList.contains("toc-link-top") || link.classList.contains("toc-link-bottom")) return;
      var href = link.getAttribute("href");
      if (href && href.charAt(0) === "#") {
        var slug = href.slice(1);
        var li = link.closest("li");
        var depthMatch = li ? li.className.match(/toc-depth-(\d)/) : null;
        headings.push({
          slug: slug,
          depth: depthMatch ? parseInt(depthMatch[1]) : 2,
        });
      }
    });

    // 收集所有目标标题元素
    var targetElements = [];
    for (var i = 0; i < headings.length; i++) {
      var el = document.getElementById(headings[i].slug);
      if (el) targetElements.push(el);
    }

    // 点击平滑滚动
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener("click", function (e) {
        var href = this.getAttribute("href");
        if (href && href.charAt(0) === "#") {
          e.preventDefault();
          var el = document.querySelector(href);
          if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    }

    // IntersectionObserver 高亮当前阅读标题
    var activeIndex = -1;

    function updateActive(index) {
      if (index === activeIndex) return;
      if (activeIndex >= 0 && activeIndex < links.length) {
        links[activeIndex].classList.remove("toc-active");
      }
      if (index >= 0 && index < links.length) {
        links[index].classList.add("toc-active");
      }
      activeIndex = index;
    }

    if (targetElements.length > 0) {
      var observer = new IntersectionObserver(
        function (entries) {
          var firstVisibleIdx = -1;
          for (var j = 0; j < entries.length; j++) {
            var entry = entries[j];
            if (entry.isIntersecting) {
              var idx = -1;
              for (var k = 0; k < headings.length; k++) {
                if (headings[k].slug === entry.target.id) {
                  idx = k;
                  break;
                }
              }
              if (idx !== -1 && (firstVisibleIdx === -1 || idx < firstVisibleIdx)) {
                firstVisibleIdx = idx;
              }
            }
          }
          if (firstVisibleIdx !== -1) updateActive(firstVisibleIdx);
        },
        {
          rootMargin: "-110px 0px -60% 0px",
          threshold: 0,
        },
      );

      for (var i = 0; i < targetElements.length; i++) {
        observer.observe(targetElements[i]);
      }

      // 页面加载后初始化高亮
      function initActive() {
        var scrollY = window.scrollY;
        var currentIdx = -1;
        for (var i = targetElements.length - 1; i >= 0; i--) {
          if (targetElements[i].offsetTop <= scrollY + 120) {
            currentIdx = i;
            break;
          }
        }
        if (currentIdx >= 0) updateActive(currentIdx);
      }

      if (document.readyState === "complete") {
        initActive();
      } else {
        window.addEventListener("load", initActive, { once: true });
      }

      // Swup 页面切换前清理
      document.addEventListener("astro:before-swap", function () {
        observer.disconnect();
      });
    }
  })();
</script>
