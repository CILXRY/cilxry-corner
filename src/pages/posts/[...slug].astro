---
// 基础骨架和样式表
import BasePageLayout from "@basePageLayout";
import "@/styles/content.scss";

// 渲染和获取内容
import { render } from "astro:content";
import { safeGetCollection } from "@ut/content/safeCollection.ts";

export async function getStaticPaths() {
  const allPosts = await safeGetCollection("posts");
  return allPosts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const allPosts = await safeGetCollection("posts");
const post = allPosts.find((p) => p.id === slug);

if (!post || post.data.draft) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(post);

const firstH1 = headings.find((h) => h.depth === 1);

import Calendar from "@lucide/astro/icons/calendar-days";
import Modified from "@lucide/astro/icons/pencil";

import Category from "@lucide/astro/icons/chart-column-stacked";
import Tags from "@lucide/astro/icons/tags";

// 声明 ViewImage 的全局类型
declare global {
  interface Window {
    ViewImage?: {
      init: (selector: string) => void;
    };
  }
}

// @ts-expect-error 缺少类型声明
import "rehype-callouts/theme/obsidian";

import TableOfContents from "@/components/Sidebar/TableOfContents.astro";
---

<BasePageLayout k={post.data.title} styled={"default"}>
  <article py4 px8 bg-surface-secondary rounded-2xl text-primary>
    <header class="post-header">
      <h1 class="post-title" font800 text-4xl mb-6 bg-clip-text text-colord>
        {post.data.title}
      </h1>
      {firstH1 && <h2 text-colord>{firstH1.text}</h2>}
      <div class="post-meta-line">
        <div class="post-meta">
          <Calendar size="16" />
          {
            post.data.creation
              ? post.data.creation.toLocaleDateString("zh-CN")
              : "缺失创建时间"
          }
        </div>
        <div class="post-meta">
          <Modified size="16" />
          {
            post.data.updated
              ? post.data.updated.toLocaleDateString("zh-CN")
              : "缺失修改时间"
          }
        </div>
        <div class="post-meta">
          <Category size="16" />
          {post.data.category ? post.data.category : "没有分类"}
        </div>
        <div class="post-meta">
          <Tags size="16" />
          {post.data.tags ? post.data.tags : "没有标签"}
        </div>
      </div>
    </header>

    <div class:list={["max-w-full", { "has-content-h1": firstH1 }]}>
      <flex>
        <div class="standard-content" lg:max-w-75% max-w-100%>
          <Content view-image />
        </div>
        <div w-25% flex-auto hidden lg:block sticky top-20 h-full ml8 class="toc">
          <TableOfContents headings={headings} />
        </div>
      </flex>

      <div id="comment"><div id="tcomment"></div></div>
      <script src="/scripts/twikoo.min.js" is:inline></script>
      <script>
        window.addEventListener("load", () => {
          (window as any).twikoo.init({
            envId: "https://t.cilxry.cc",
            el: "#tcomment",
          });
        });
      </script>
    </div>
  </article>
  <script src="/scripts/view-image.min.js" is:inline></script>
  <script>
    window.ViewImage && window.ViewImage.init("img");
  </script>
</BasePageLayout>

<style scoped>
  .markdown-body {
    animation: fadeInUp 0.6s ease-out;
  }

  .has-content-h1 :global(h1:first-of-type) {
    display: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
