---
// 基础骨架和样式表
import BasePageLayout from "@basePageLayout";
import "@/styles/content.scss";

// 渲染和获取内容
import { render } from "astro:content";
import { safeGetCollection } from "@ut/content/safeCollection.ts";

export async function getStaticPaths() {
  const allPosts = await safeGetCollection("posts");
  return allPosts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const allPosts = await safeGetCollection("posts");
const post = allPosts.find((p) => p.id === slug);

if (!post || post.data.draft) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(post);

const firstH1 = headings.find((h) => h.depth === 1);

// 声明 ViewImage 的全局类型
declare global {
  interface Window {
    ViewImage?: {
      init: (selector: string) => void;
    };
  }
}

// @ts-expect-error 缺少类型声明
import "rehype-callouts/theme/obsidian";

import TableOfContents from "@/components/Sidebar/TableOfContents.astro";
import PostMetaLine from "@cp/P_posts/PostMetaLine.astro";
---

<BasePageLayout k={post.data.title} styled={"default"}>
  <article py4 px8 bg-surface-secondary rounded-2xl text-primary>
    <header class="post-header">
      <h1 class="post-title" font800 text-4xl mb-6 bg-clip-text text-colord>
        {post.data.title}
      </h1>
      {firstH1 && <h2 text-colord>{firstH1.text}</h2>}
      <PostMetaLine
        creation={post.data.creation}
        updated={post.data.updated}
        category={post.data.category}
        tags={post.data.tags}
      />
    </header>

    <div class:list={["max-w-full", { "has-content-h1": firstH1 }]}>
      <flex>
        <div class="standard-content" lg:max-w-75% max-w-100% flex-1>
          <Content view-image />
        </div>
        <div
          max-w-25%
          flex-auto
          hidden
          lg:block
          sticky
          top-20
          h-full
          ml8
          class="toc"
        >
          <TableOfContents headings={headings} />
        </div>
      </flex>

      <div id="comment"><div id="tcomment"></div></div>
      <script src="/scripts/twikoo.min.js" is:inline></script>
      <script>
        function initTwikoo() {
          if (window.twikoo) {
            window.twikoo.init({
              envId: "https://t.cilxry.cc",
              el: "#tcomment",
            });
          }
        }
        // 首次
        document.addEventListener("DOMContentLoaded", initTwikoo);

        // Swup
        document.addEventListener("swup:page:view", initTwikoo);
      </script>
    </div>
  </article>
  <script src="/scripts/view-image.min.js" is:inline data-swup-ignore-script
  ></script>
  <script>
    window.ViewImage && window.ViewImage.init("img");
  </script>
</BasePageLayout>

<style scoped>
  .markdown-body {
    animation: fadeInUp 0.6s ease-out;
  }

  .has-content-h1 :global(h1:first-of-type) {
    display: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
