---
// 根级 Catch-All 重定向页面
// 处理短 ID（如 /001）和标题（如 /「纪事小栈」...）到规范 URL 的重定向
import { safeGetCollection } from "@ut/content/safeCollection.ts";

export async function getStaticPaths() {
  const allPosts = await safeGetCollection("posts");
  const paths: { params: { slug: string } }[] = [];

  for (const post of allPosts) {
    // 1. 短 ID：取第一个 "_" 之前的部分
    const shortId = post.id.split("_")[0];
    if (shortId) {
      paths.push({ params: { slug: shortId } });
    }

    // 2. 标题
    const title = post.data.title;
    if (title) {
      paths.push({ params: { slug: title } });
    }
  }

  return paths;
}

const { slug } = Astro.params;
const allPosts = await safeGetCollection("posts");

const matchedPost = allPosts.find((p) => {
  const shortId = p.id.split("_")[0];
  return slug === shortId || slug === p.data.title;
});

// 兜底：getStaticPaths 只生成有效路径，理论上不会进这里
if (!matchedPost) {
  return Astro.redirect("/404", 302);
}

const redirectTo = `/posts/${encodeURIComponent(matchedPost.id)}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <title>正在跳转...</title>
    <style>
      :root {
        --bg-surface: oklch(0.15 0.03 0.1);
        --bg-surface-secondary: oklch(0.18 0.04 0.1);
        --bg-surface-tertiary: oklch(0.22 0.05 0.1);
        --text-primary: oklch(0.92 0 0);
        --text-secondary: oklch(0.75 0 0);
        --text-colord: oklch(0.85 0.11 0.1);
        --cp-500: oklch(0.55 0.11 0.1);
        --cp-600: oklch(0.48 0.11 0.1);
        --font-list-fallback: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: var(--bg-surface);
        color: var(--text-secondary);
        font-family: var(--font-list-fallback);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .card {
        background: var(--bg-surface-tertiary);
        border-radius: 16px;
        padding: 48px 40px;
        text-align: center;
        max-width: 420px;
        width: 90%;
      }
      .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--bg-surface-secondary);
        border-top-color: var(--cp-500);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 24px;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      p { font-size: 15px; line-height: 1.6; }
      a {
        color: var(--text-colord);
        text-decoration: none;
        word-break: break-all;
      }
      a:hover { text-decoration: underline; }
      .btn {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 24px;
        background: var(--cp-500);
        color: #fff;
        border-radius: 10px;
        font-size: 14px;
        transition: background 0.2s;
      }
      .btn:hover {
        background: var(--cp-600);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <p>正在跳转到目标页面...</p>
      <a href={redirectTo}>{redirectTo}</a>
      <br />
      <a href={redirectTo} class="btn">手动跳转</a>
    </div>
    <script is:inline>
      window.location.replace("{redirectTo}");
    </script>
  </body>
</html>
